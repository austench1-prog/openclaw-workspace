//@version=5
indicator("Camarilla Weekly Midnight v20", overlay=true, max_bars_back=1000)

// ============================================================
// Camarilla Weekly - Midnight Edition v20
// Uses 1-minute bars with America/New_York timezone
// to find exact 00:00 ET Monday open (true midnight)
// and exact 16:00 ET Friday close
// ============================================================

// Weekly H/L from weekly bar (most reliable)
LWH = request.security(syminfo.tickerid, "W", high[1])
LWL = request.security(syminfo.tickerid, "W", low[1])

// 1-minute bars with New York timezone
// At 00:00 ET on Monday, this is the true midnight open

// This week Monday 00:00 ET open (occurrence 0 = most recent)
WO = request.security(syminfo.tickerid, "1",
     ta.valuewhen(
         hour(time, "America/New_York") == 0 and
         minute(time, "America/New_York") == 0 and
         dayofweek(time, "America/New_York") == dayofweek.monday,
         open, 0),
     lookahead=barmerge.lookahead_on)

// Last week Monday 00:00 ET open (occurrence 1 = previous)
LWO = request.security(syminfo.tickerid, "1",
     ta.valuewhen(
         hour(time, "America/New_York") == 0 and
         minute(time, "America/New_York") == 0 and
         dayofweek(time, "America/New_York") == dayofweek.monday,
         open, 1),
     lookahead=barmerge.lookahead_on)

// Last week Friday 16:00 ET close
LWC = request.security(syminfo.tickerid, "1",
     ta.valuewhen(
         hour(time, "America/New_York") == 16 and
         minute(time, "America/New_York") == 0 and
         dayofweek(time, "America/New_York") == dayofweek.friday,
         close, 1),
     lookahead=barmerge.lookahead_on)

// Formula
P   = (LWH + LWL + LWO + LWC) / 4
B   = 2 * P + WO - LWC
NWH = B - LWL
NWL = B - LWH
MID = (NWH + NWL) / 2

// Plot
plot(NWH, "NWH", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)
plot(NWL, "NWL", color=color.new(color.blue, 0), linewidth=2, style=plot.style_linebr)
plot(MID, "MID", color=color.new(color.yellow, 0), linewidth=1, style=plot.style_linebr)

// Label (compact)
if barstate.islast
    label.new(bar_index, NWH,
     "NWH=" + str.tostring(math.round(NWH, 2)) +
     " MID=" + str.tostring(math.round(MID, 2)) +
     " NWL=" + str.tostring(math.round(NWL, 2)) +
     "\nLWO(Mon 00:00ET)=" + str.tostring(math.round(LWO, 2)) +
     " LWC(Fri 16:00ET)=" + str.tostring(math.round(LWC, 2)) +
     "\nWO(Mon 00:00ET)=" + str.tostring(math.round(WO, 2)),
     style=label.style_label_left,
     color=color.new(color.blue, 20),
     textcolor=color.white,
     size=size.small)
