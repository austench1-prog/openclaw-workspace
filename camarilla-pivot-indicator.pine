//@version=6
indicator("Camarilla TH/TL Zone", overlay=true)

// ================================================================
// 模块1：昨日日线 H / L / C
// ================================================================
prevH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
prevL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
prevC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// ================================================================
// 模块2：记录今日 09:30 RTH 开盘价（只赋值一次）
// ================================================================
isRTHOpen = (hour == 9 and minute == 30)
isRTH     = (hour > 9 or (hour == 9 and minute >= 30)) and hour < 16

var float todayO = na

if isRTHOpen
    todayO := open

// ================================================================
// 模块3：计算 P / B / TH / TL（B = 2P）
// ================================================================
var float todayP  = na
var float todayB  = na
var float todayTH = na
var float todayTL = na

if isRTHOpen and not na(prevH) and not na(todayO)
    todayP  := (prevH + prevL + prevC) / 3
    todayB  := 2 * todayP
    todayTH := todayB - prevL
    todayTL := todayB - prevH

// ================================================================
// 模块4：绘图 — RTH 时段显示，非RTH隐藏
// ================================================================
thPlot = plot(isRTH and not na(todayTH) ? todayTH : na,
     title     = "TH",
     color     = color.new(color.blue, 20),
     linewidth = 2,
     style     = plot.style_linebr)

tlPlot = plot(isRTH and not na(todayTL) ? todayTL : na,
     title     = "TL",
     color     = color.new(color.blue, 20),
     linewidth = 2,
     style     = plot.style_linebr)

fill(thPlot, tlPlot,
     color = color.new(color.blue, 82),
     title = "TH-TL Zone")

// ================================================================
// 右上角表格
// ================================================================
var table tbl = table.new(position.top_right, 2, 6,
     bgcolor      = color.new(color.black, 60),
     border_width = 1)

if barstate.islast
    table.cell(tbl, 0, 0, "昨H",  text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 1, 0, str.tostring(prevH,   "#.00"), text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 0, 1, "昨L",  text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 1, 1, str.tostring(prevL,   "#.00"), text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 0, 2, "昨C",  text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 1, 2, str.tostring(prevC,   "#.00"), text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 0, 3, "开盘O", text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 1, 3, str.tostring(todayO,  "#.00"), text_color=color.white, text_size=size.small, bgcolor=color.new(color.gray,60))
    table.cell(tbl, 0, 4, "TH",   text_color=color.black, text_size=size.small, bgcolor=color.new(color.blue,30))
    table.cell(tbl, 1, 4, str.tostring(todayTH, "#.00"), text_color=color.black, text_size=size.small, bgcolor=color.new(color.blue,30))
    table.cell(tbl, 0, 5, "TL",   text_color=color.black, text_size=size.small, bgcolor=color.new(color.blue,30))
    table.cell(tbl, 1, 5, str.tostring(todayTL, "#.00"), text_color=color.black, text_size=size.small, bgcolor=color.new(color.blue,30))

// ================================================================
// 告警
// ================================================================
if not na(todayTH) and close >= todayTH * 0.9998
    alert("触及 TH: " + str.tostring(todayTH, "#.00"), alert.freq_once_per_bar_close)
if not na(todayTL) and close <= todayTL * 1.0002
    alert("触及 TL: " + str.tostring(todayTL, "#.00"), alert.freq_once_per_bar_close)
