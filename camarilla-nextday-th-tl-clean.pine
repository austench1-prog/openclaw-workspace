//@version=6
indicator("Camarilla Next-Day TH/TL", overlay=true, max_labels_count=10)

// Previous completed daily bar = basis for NEXT day levels
prevH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevL = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
prevC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// Regular trading hours only
isRTH = ((hour > 9) or (hour == 9 and minute >= 30)) and hour < 16

// Next-day projection based only on previous day H/L/C
P = (prevH + prevL + prevC) / 3
B = 2 * P
TH = B - prevL
TL = B - prevH
MID = (TH + TL) / 2

thPlot = plot(isRTH ? TH : na, title="Tomorrow High", color=color.aqua, linewidth=3, style=plot.style_linebr)
tlPlot = plot(isRTH ? TL : na, title="Tomorrow Low", color=color.aqua, linewidth=3, style=plot.style_linebr)
midPlot = plot(isRTH ? MID : na, title="Mid", color=color.yellow, linewidth=2, style=plot.style_linebr)

fill(thPlot, tlPlot, color=color.new(color.blue, 78), title="Tomorrow Zone")

var label lbTH = na
var label lbTL = na
var label lbMID = na

if barstate.islast and isRTH
    label.delete(lbTH)
    label.delete(lbTL)
    label.delete(lbMID)
    lbTH := label.new(bar_index + 1, TH, "TH " + str.tostring(TH, "#.00"), color=color.aqua, textcolor=color.black, style=label.style_label_left, size=size.small)
    lbTL := label.new(bar_index + 1, TL, "TL " + str.tostring(TL, "#.00"), color=color.aqua, textcolor=color.black, style=label.style_label_left, size=size.small)
    lbMID := label.new(bar_index + 1, MID, "MID " + str.tostring(MID, "#.00"), color=color.yellow, textcolor=color.black, style=label.style_label_left, size=size.small)

var table tbl = table.new(position.top_right, 2, 6, bgcolor=color.new(color.black, 55), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "Prev H", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 1, 0, str.tostring(prevH, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 0, 1, "Prev L", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 1, 1, str.tostring(prevL, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 0, 2, "Prev C", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 1, 2, str.tostring(prevC, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 0, 3, "P", text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 1, 3, str.tostring(P, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60))
    table.cell(tbl, 0, 4, "TH", text_color=color.black, bgcolor=color.new(color.aqua, 20))
    table.cell(tbl, 1, 4, str.tostring(TH, "#.00"), text_color=color.black, bgcolor=color.new(color.aqua, 20))
    table.cell(tbl, 0, 5, "TL", text_color=color.black, bgcolor=color.new(color.aqua, 20))
    table.cell(tbl, 1, 5, str.tostring(TL, "#.00"), text_color=color.black, bgcolor=color.new(color.aqua, 20))
