//@version=6
// Formula 2 - Weighted Open
// Uses TODAY H/L/C + TOMORROW open (TO) to predict TOMORROW TH/TL
// P  = (H + L + C) / 3
// D  = C - TO
// B  = 2P + D
// TH = B - L
// TL = B - H
indicator("Camarilla F2 - Weighted Open", overlay=true, max_labels_count=10)

isRTH = ((hour > 9) or (hour == 9 and minute >= 30)) and hour < 16
isRTHOpen = hour == 9 and minute == 30

todayH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
todayL = request.security(syminfo.tickerid, "D", low[1], lookahead=barmerge.lookahead_on)
todayC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)

// Capture tomorrow's open at 09:30 (locked for the day)
var float TO = na
if isRTHOpen
    TO := open

P  = (todayH + todayL + todayC) / 3
D  = todayC - TO
B  = 2 * P - D
TH = B - todayL
TL = B - todayH
MID = (TH + TL) / 2

showLevels = isRTH and not na(TO)

thPlot = plot(showLevels ? TH : na, title="TH", color=color.orange, linewidth=2, style=plot.style_linebr)
tlPlot = plot(showLevels ? TL : na, title="TL", color=color.orange, linewidth=2, style=plot.style_linebr)
plot(showLevels ? MID : na, title="MID", color=color.yellow, linewidth=1, style=plot.style_linebr)
fill(thPlot, tlPlot, color=color.new(color.orange, 85), title="F2 Zone")

var label lbTH = na
var label lbTL = na
if barstate.islast and showLevels
    label.delete(lbTH)
    label.delete(lbTL)
    lbTH := label.new(bar_index+1, TH, "F2 TH " + str.tostring(TH, "#.00"), color=color.orange, textcolor=color.black, style=label.style_label_left, size=size.small)
    lbTL := label.new(bar_index+1, TL, "F2 TL " + str.tostring(TL, "#.00"), color=color.orange, textcolor=color.black, style=label.style_label_left, size=size.small)

var table tbl = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 55), border_width=1)
if barstate.islast
    table.cell(tbl, 0, 0, "F2 - Wtd Open", text_color=color.yellow, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(tbl, 1, 0, "D=C-TO B=2P-D", text_color=color.yellow, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(tbl, 0, 1, "Today H", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(todayH, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 2, "Today L", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(todayL, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 3, "Today C", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(todayC, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 4, "Tmrw TO", text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 4, na(TO) ? "Waiting..." : str.tostring(TO, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 5, "Tmrw TH", text_color=color.black, bgcolor=color.new(color.orange, 30), text_size=size.small)
    table.cell(tbl, 1, 5, na(TO) ? "N/A" : str.tostring(TH, "#.00"), text_color=color.black, bgcolor=color.new(color.orange, 30), text_size=size.small)
    table.cell(tbl, 0, 6, "Tmrw TL", text_color=color.black, bgcolor=color.new(color.orange, 30), text_size=size.small)
    table.cell(tbl, 1, 6, na(TO) ? "N/A" : str.tostring(TL, "#.00"), text_color=color.black, bgcolor=color.new(color.orange, 30), text_size=size.small)
