//@version=6
// Formula 3 - Futures (NQ)
// P = (H + L + C + O) / 4   where O = 0:01am open (earliest price of the day)
// B = 2 * P
// TH = B - L   (Tomorrow High)
// TL = B - H   (Tomorrow Low)
//
// Display window: 00:00 to 16:00 (today's zone)
// After 16:01: table immediately shows TOMORROW's TH/TL using today's H/L/C + today's O
// H/L/C = full 24h futures session

indicator("Camarilla F3 - Futures NQ", overlay=true, max_labels_count=10)

// ============================================================
// Time flags
// ============================================================
isRTH     = ((hour > 9) or (hour == 9 and minute >= 30)) and hour < 16
inWindow  = hour >= 0 and hour < 16
isAfter16 = hour >= 16

// ============================================================
// Lock today's 0:01am O at midnight open
// ============================================================
var float todayO = na
if hour == 0 and minute == 0
    todayO := open

// ============================================================
// Get daily data
// ============================================================
// For ACTIVE display (today's zone): use yesterday's H/L/C
prevH = request.security(syminfo.tickerid, "D", high[1],  lookahead=barmerge.lookahead_on)
prevL = request.security(syminfo.tickerid, "D", low[1],   lookahead=barmerge.lookahead_on)
prevC = request.security(syminfo.tickerid, "D", close[1], lookahead=barmerge.lookahead_on)
prevO = request.security(syminfo.tickerid, "D", open[1],  lookahead=barmerge.lookahead_on)

// For PREVIEW (after 16:01): use today's H/L/C (current day, still building)
curH = request.security(syminfo.tickerid, "D", high,  lookahead=barmerge.lookahead_on)
curL = request.security(syminfo.tickerid, "D", low,   lookahead=barmerge.lookahead_on)
curC = request.security(syminfo.tickerid, "D", close, lookahead=barmerge.lookahead_on)

// ============================================================
// ACTIVE levels: displayed 00:00 - 16:00
// Uses: yesterday H/L/C + yesterday's 0:01am O
// (prevO approximates yesterday's earliest open from daily bar)
// ============================================================
P_act  = (prevH + prevL + prevC + prevO) / 4
B_act  = 2 * P_act
TH_act = B_act - prevL
TL_act = B_act - prevH
MID_act = (TH_act + TL_act) / 2

showActive = inWindow and not na(prevH)

thPlot = plot(showActive ? TH_act : na, title="TH", color=color.fuchsia, linewidth=2, style=plot.style_linebr)
tlPlot = plot(showActive ? TL_act : na, title="TL", color=color.fuchsia, linewidth=2, style=plot.style_linebr)
plot(showActive ? MID_act : na, title="MID", color=color.yellow, linewidth=1, style=plot.style_linebr)
fill(thPlot, tlPlot, color=color.new(color.purple, 85), title="F3 Zone")

// Labels on active zone
var label lbTH  = na
var label lbTL  = na
var label lbMID = na
if barstate.islast and showActive
    label.delete(lbTH)
    label.delete(lbTL)
    label.delete(lbMID)
    lbTH  := label.new(bar_index+1, TH_act,  "TH "  + str.tostring(TH_act,  "#.00"), color=color.fuchsia, textcolor=color.black, style=label.style_label_left, size=size.small)
    lbTL  := label.new(bar_index+1, TL_act,  "TL "  + str.tostring(TL_act,  "#.00"), color=color.fuchsia, textcolor=color.black, style=label.style_label_left, size=size.small)
    lbMID := label.new(bar_index+1, MID_act, "MID " + str.tostring(MID_act, "#.00"), color=color.yellow,  textcolor=color.black, style=label.style_label_left, size=size.small)

// ============================================================
// PREVIEW levels: computed immediately after 16:00
// Uses: today H/L/C (locked at close) + today's 0:01am O
// This gives TOMORROW's TH/TL right after today's session ends
// ============================================================
P_pre  = (curH + curL + curC + todayO) / 4
B_pre  = 2 * P_pre
TH_pre = B_pre - curL
TL_pre = B_pre - curH
MID_pre = (TH_pre + TL_pre) / 2

// ============================================================
// Table: switches between ACTIVE and PREVIEW automatically
// ============================================================
var table tbl = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 55), border_width=1)

if barstate.islast
    bool preview = isAfter16
    string mode  = preview ? "TOMORROW Preview" : "TODAY Active"
    color modeCol = preview ? color.new(color.orange, 10) : color.new(color.blue, 20)

    float dH   = preview ? curH    : prevH
    float dL   = preview ? curL    : prevL
    float dC   = preview ? curC    : prevC
    float dO   = preview ? todayO  : prevO
    float dTH  = preview ? TH_pre  : TH_act
    float dTL  = preview ? TL_pre  : TL_act
    float dMID = preview ? MID_pre : MID_act

    table.cell(tbl, 0, 0, "F3 Futures NQ", text_color=color.yellow, bgcolor=color.new(color.black, 30), text_size=size.small)
    table.cell(tbl, 1, 0, mode, text_color=color.black, bgcolor=modeCol, text_size=size.small)
    table.cell(tbl, 0, 1, "H",      text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 1, str.tostring(dH,   "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 2, "L",      text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 2, str.tostring(dL,   "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 3, "C",      text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 3, str.tostring(dC,   "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 4, "O 0am",  text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 1, 4, na(dO) ? "N/A" : str.tostring(dO, "#.00"), text_color=color.white, bgcolor=color.new(color.gray, 60), text_size=size.small)
    table.cell(tbl, 0, 5, "---", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
    table.cell(tbl, 1, 5, "---", text_color=color.gray, bgcolor=color.new(color.black, 50), text_size=size.small)
    table.cell(tbl, 0, 6, "TH",  text_color=color.black, bgcolor=color.new(color.fuchsia, 30), text_size=size.small)
    table.cell(tbl, 1, 6, str.tostring(dTH,  "#.00"), text_color=color.black, bgcolor=color.new(color.fuchsia, 30), text_size=size.small)
    table.cell(tbl, 0, 7, "MID", text_color=color.black, bgcolor=color.new(color.yellow, 30), text_size=size.small)
    table.cell(tbl, 1, 7, str.tostring(dMID, "#.00"), text_color=color.black, bgcolor=color.new(color.yellow, 30), text_size=size.small)
    table.cell(tbl, 0, 8, "TL",  text_color=color.black, bgcolor=color.new(color.fuchsia, 30), text_size=size.small)
    table.cell(tbl, 1, 8, str.tostring(dTL,  "#.00"), text_color=color.black, bgcolor=color.new(color.fuchsia, 30), text_size=size.small)
